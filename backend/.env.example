# Copy to .env and fill in.

# PostgreSQL connection string.
#   Local (docker compose up -d):  postgresql://flowforge:flowforge@localhost:5432/flowforge
#   Neon:                          postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://flowforge:flowforge@localhost:5432/flowforge

PORT=5001
NODE_ENV=development

# Secret used to sign JWTs. MUST be a strong random value in production.
JWT_SECRET=dev-secret-change-in-prod
JWT_EXPIRES_IN=12h

# Only used in production: URL the keep-alive cron pings every 14 min (for Render free tier).
API_URL=
